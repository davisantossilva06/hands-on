programa {
  funcao inicio() {
    inteiro soma, div, n1, n2
    escreva("Escreva um numero: ")
    leia(n1)
    escreva("Escreva um segundo numero: ")
    leia(n2)
    soma = n1 + n2
    div = n1 / n2
    escreva("\n")
    escreva("A soma é "+ soma + ".\n")
    escreva("Soma: "+ n1 + " + " + n2 + " = " + soma +".\n")
    escreva("Divisao: " + n1 + "/" + n2 + " = " + div)
  }
}
